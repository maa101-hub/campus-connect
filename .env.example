# ╔═══════════════════════════════════════════════════════════╗
# ║       CAMPUS CONNECT - ENVIRONMENT VARIABLES             ║
# ║  Copy this file to .env and fill in your actual values   ║
# ╚═══════════════════════════════════════════════════════════╝

# ─── DATABASE ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus-connect
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
# SSL mode for the JDBC connection. Use "require" for managed DBs (Render),
# "disable" for a plain local/CI Postgres without SSL. Defaults to "require".
DB_SSLMODE=require

# ─── REDIS ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ────────────────────────────────────────────────────
# IMPORTANT: Change this in production! Minimum 32 characters.
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRATION=86400000

# ─── EMAIL / OTP (Gmail SMTP) ──────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ─── SERVICE PORTS ──────────────────────────────────────────
USER_SERVICE_PORT=8081
POST_SERVICE_PORT=8082
DISCOVERY_SERVER_PORT=8761

# ─── EUREKA (optional) ──────────────────────────────────────
# Service discovery is optional now that routing is direct (gateway removed).
# Leave EUREKA_ENABLED=false to run services standalone (e.g. on Render).
# Set to true and provide EUREKA_URL only if you deploy the discovery-server.
EUREKA_ENABLED=false
EUREKA_URL=http://localhost:8761/eureka/

# ─── CORS ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── FRONTEND ──────────────────────────────────────────────
# The API gateway has been removed. Requests use relative paths and are routed
# by nginx (Docker), the Vite dev-server proxy (local dev), or Vercel rewrites
# (see frontend/campusconnect/vercel.json in production):
#   /api/posts/**  -> post-service (8082)
#   /api/**, /ws   -> user-service (8081)
#   /uploads/**    -> user-service (8081)
#
# VITE_API_URL: leave EMPTY for relative requests (recommended for Docker/Vercel).
VITE_API_URL=
# VITE_WS_URL: WebSocket origin. Empty = current page origin (Docker/local dev).
# On Vercel, set this to the user-service public URL, because Vercel rewrites
# do not proxy WebSockets — e.g. https://campus-connect-2-wszu.onrender.com
VITE_WS_URL=
